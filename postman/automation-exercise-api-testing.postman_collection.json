                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const response = pm.response;\r\nconst responseBody = pm.response.json();\r\nconst products = responseBody.products;\r\n\r\npm.test(\"Verify response status code is 200\", function () {\r\n    response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Verify response body is a vaild JSON\", function () {\r\n    pm.expect(response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r\n});\r\n\r\npm.test(\"Verify category of products is Tshirts\", function () {\r\n    products.forEach(product => {\r\n        pm.expect(product.category.category).to.include(\"shirt\");\r\n    });\r\n});\r\n\r\n"
                    ]
                  }
