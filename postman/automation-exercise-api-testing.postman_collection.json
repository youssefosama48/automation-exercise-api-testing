        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\nconst products_array_length = response.products.length;\r\n\r\n pm.test(\"Verify response code is 200\", function () {\r\n        pm.response.to.have.status(200);\r\n });\r\n\r\npm.test(\"Verify response body is valid JSON\", () => {\r\n    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r\n});\r\n\r\npm.test(\"Verify response body contains products property\", () => {\r\n    pm.expect(response).to.have.property('products');\r\n});\r\n\r\npm.test(\"Verify products is an array \", function () {\r\n    pm.expect(response.products).to.be.an('array');\r\n});\r\n\r\npm.test(\"Verify products list contains at least one product\", function () {\r\n    pm.expect(response.products.length).to.be.at.least(1);\r\n});\r\n\r\n\r\npm.test(\"Verify each product object contains id, name, price, brand, category\", function () {\r\n    response.products.forEach(function (product) {\r\n        pm.expect(product).to.have.property('id');\r\n        pm.expect(product).to.have.property('name');\r\n        pm.expect(product).to.have.property('price');\r\n        pm.expect(product).to.have.property('brand');\r\n        pm.expect(product).to.have.property('category');\r\n    });\r\n});\r\n\r\npm.test(\"Verify category property is an object\", function () {\r\n    pm.expect(response.products[0].category).to.be.an('object');\r\n    pm.expect(response.products[products_array_length - 1].category).to.be.an('object');\r\n});\r\n\r\npm.test(\"Verify category object contains usertype and category\", function () {\r\n    pm.expect(response.products[0].category).to.have.property('usertype');\r\n    pm.expect(response.products[0].category).to.have.property('category');\r\n    pm.expect(response.products[products_array_length - 1].category).to.have.property('usertype');\r\n    pm.expect(response.products[products_array_length - 1].category).to.have.property('category');\r\n});\r\n\r\npm.test(\"Verify 'usertype' is an object\", function () {\r\n    pm.expect(response.products[0].category.usertype).to.be.an('object');\r\n    pm.expect(response.products[products_array_length - 1].category.usertype).to.be.an('object');\r\n});\r\n\r\npm.test(\"Verify 'usertype' has 'usertype' property\", function () {\r\n    pm.expect(response.products[0].category.usertype).to.have.property('usertype');\r\n    pm.expect(response.products[products_array_length - 1].category.usertype).to.have.property('usertype'); \r\n});"
                ]
              }
            }
          ],
